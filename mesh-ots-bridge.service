[Unit]
Description=Meshtastic to OpenTakServer Bridge
After=network.target opentakserver.service
Wants=opentakserver.service

[Service]
Type=simple
User=ss
WorkingDirectory=/opt/mesh-ots-bridge
ExecStart=/usr/bin/python3 /opt/mesh-ots-bridge/daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
