[Unit]
Description=Meshtastic to OpenTakServer Bridge
After=network.target
# Soft dependency — bridge starts even if OTS isn't a systemd service
Wants=opentakserver.service

[Service]
Type=simple
User=ss
WorkingDirectory=/opt/mesh-ots-bridge
ExecStart=/usr/bin/python3 /opt/mesh-ots-bridge/daemon.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
